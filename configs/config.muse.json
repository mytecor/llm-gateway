{
  "host": "127.0.0.1",
  "port": 9208,
  "metrics_host": "127.0.0.1",
  "metrics_port": 9209,
  "log_level": "info",
  "session_file": "./state/sessions.json",
  "providers": [
    {
      "id": "muse-provider",
      "driver": "web",
      "tool_strategy": "prompt",
      "profile": "./drivers/web/sites/muse.yaml",
      "cdp_url": "http://127.0.0.1:19222",
      "account": "main",
      "session": {
        "default_cwd": ".",
        "allowed_roots": ["."],
        "ttl": "30m",
        "turn_timeout": "15m"
      }
    }
  ],
  "rules": [
    {
      "route": "muse",
      "action": "filter",
      "where": {
        "model": {
          "eq": "muse"
        }
      }
    },
    {
      "route": "muse",
      "action": "map",
      "providers": ["muse-provider"],
      "native": "default"
    },
    {
      "route": "muse",
      "action": "race",
      "count": 1
    }
  ]
}
