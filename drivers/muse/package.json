{
  "name": "llm-gateway-muse-driver",
  "version": "1.0.0",
  "description": "Universal Playwright driver for Meta Muse (muse.ai) integration in llm-gateway",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
